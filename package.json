{
  "name": "system-lens",
  "productName": "SystemLens",
  "description": "AI-powered codebase intelligence",
  "author": "Dominic Slonka",
  "main": "electron/main.js",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "electron": "electron .",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.dominicslonka.systemlens",
    "productName": "SystemLens",
    "copyright": "Copyright © 2026 Dominic Slonka",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SystemLens-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "DSlonka",
      "repo": "LegacyLens"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "jspdf": "^2.5.2",
    "postcss-media-query-parser": "^0.2.3",
    "rxjs": "~7.8.0",
    "shiki": "^1.29.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
